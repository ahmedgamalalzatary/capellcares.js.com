FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS deps
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEV_ADMIN_EMAIL
ARG NEXT_PUBLIC_DEV_ADMIN_PASSWORD
ARG API_INTERNAL_URL
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/erp/package.json apps/erp/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEV_ADMIN_EMAIL
ARG NEXT_PUBLIC_DEV_ADMIN_PASSWORD
ARG API_INTERNAL_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_DEV_ADMIN_EMAIL=$NEXT_PUBLIC_DEV_ADMIN_EMAIL
ENV NEXT_PUBLIC_DEV_ADMIN_PASSWORD=$NEXT_PUBLIC_DEV_ADMIN_PASSWORD
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY . .
RUN pnpm --filter @capella/erp build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV API_INTERNAL_URL=http://api:4000
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/erp/node_modules ./apps/erp/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .
COPY --from=builder /app/apps/erp/.next ./apps/erp/.next
WORKDIR /app/apps/erp
EXPOSE 3001
CMD ["pnpm", "start"]
