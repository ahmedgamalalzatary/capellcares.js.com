FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS deps
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG API_INTERNAL_URL
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/erp/package.json apps/erp/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG API_INTERNAL_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY . .
RUN pnpm --filter @capella/erp build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV API_INTERNAL_URL=http://api:4000
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app/apps/erp/.next/standalone ./
COPY --from=builder /app/apps/erp/.next/static ./apps/erp/.next/static
EXPOSE 3001
CMD ["node", "apps/erp/server.js"]
