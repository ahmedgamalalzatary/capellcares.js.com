{
  "name": "capella",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@capella/mobile",
    "build:mobile-stack": "turbo run build --filter=@capella/mobile --filter=@capella/api",
    "build:web": "turbo run build --filter=@capella/storefront",
    "build:web-stack": "turbo run build --filter=@capella/storefront --filter=@capella/api",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@capella/mobile",
    "dev:mobile-stack": "turbo run dev --filter=@capella/mobile --filter=@capella/api",
    "dev:web": "turbo run dev --filter=@capella/storefront",
    "dev:web-stack": "turbo run dev --filter=@capella/storefront --filter=@capella/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4",
    "test:staging-smoke": "playwright test tests/e2e/staging/critical"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "turbo": "^2.9.14"
  }
}
