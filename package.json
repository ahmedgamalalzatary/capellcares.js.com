{
  "name": "capella",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@capella/mobile --filter=@capella/api",
    "build:web": "turbo run build --filter=@capella/storefront --filter=@capella/erp --filter=@capella/api",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@capella/mobile --filter=@capella/api",
    "dev:web": "turbo run dev --filter=@capella/storefront --filter=@capella/erp --filter=@capella/api",
    "lint": "turbo run lint",
    "lint:mobile": "turbo run lint --filter=@capella/mobile --filter=@capella/api",
    "lint:web": "turbo run lint --filter=@capella/storefront --filter=@capella/erp --filter=@capella/api",
    "typecheck": "turbo run typecheck",
    "typecheck:mobile": "turbo run typecheck --filter=@capella/mobile --filter=@capella/api",
    "typecheck:web": "turbo run typecheck --filter=@capella/storefront --filter=@capella/erp --filter=@capella/api",
    "test": "turbo run test --concurrency=4",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:mobile": "turbo run test --filter=@capella/mobile --filter=@capella/api --concurrency=4",
    "test:web": "turbo run test --filter=@capella/storefront --filter=@capella/erp --filter=@capella/api --concurrency=4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "turbo": "^2.9.14"
  }
}
