# Required for a physical device and every production build.
# Emulator/simulator may infer a host in development:
#   Android emulator: http://10.0.2.2:4000
#   iOS simulator:    http://localhost:4000
# A phone on the LAN cannot use localhost — set the PC's reachable address:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
