FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
# Bundle the API (inlining @minikoshk/* TS + pure-JS deps) into a single
# dist/server.js. Only mysql2 stays external, so the runtime node_modules is
# just mysql2 + its transitive deps (~5 MB) instead of the whole workspace
# dependency closure (which would drag in @minikoshk/shared's React/Radix/Lucide).
RUN pnpm --filter @minikoshk/api build:bundle
RUN mkdir -p /prod && cd /prod \
    && npm init -y >/dev/null \
    && npm install --omit=dev --no-audit --no-fund mysql2@^3.11.3

FROM base AS runner
WORKDIR /app/apps/api
ENV NODE_ENV=production
COPY --from=builder /prod/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./dist
RUN mkdir -p uploads
EXPOSE 4000
CMD ["node", "dist/server.mjs"]
