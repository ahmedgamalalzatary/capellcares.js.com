# Core
NODE_ENV=development
PORT=4000

# Database
# Example MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/minikoshk
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=minikoshk
MYSQL_USER=capella
MYSQL_PASSWORD=replace-with-strong-app-password

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
STOREFRONT_BASE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=replace-with-long-random-revalidate-secret

# CORS allowlist (comma-separated). REQUIRED in production: the API refuses to
# boot when NODE_ENV=production and this is unset (no arbitrary-origin fallback).
# Outside production it defaults to the localhost dev origins below.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth — secrets below are REQUIRED in production. When NODE_ENV=production and
# any of JWT_ACCESS_SECRET / STOREFRONT_REVALIDATE_SECRET is unset, the app fails
# to start (no dev-default fallback) instead of signing with a public default.
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# Admin bootstrap - server-only, seeds the initial admin user
ADMIN_NAME=Capella Admin
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-strong-admin-password

# Uploads / Hostinger - planned Phase 12
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,video/mp4,video/webm
HOSTINGER_HOST=placeholder-hostinger-host
HOSTINGER_PORT=22
HOSTINGER_USERNAME=placeholder-username
HOSTINGER_PASSWORD=placeholder-password
HOSTINGER_REMOTE_DIR=/public_html/uploads
HOSTINGER_PUBLIC_BASE_URL=https://example.com/uploads
