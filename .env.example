# Core
NODE_ENV=development
PORT=4000

# Database
# Example MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/capella
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=capella
MYSQL_USER=capella
MYSQL_PASSWORD=replace-with-strong-app-password

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth - planned Phase 9
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# Temporary ERP dev fallback - must not be production auth
ALLOW_DEV_ADMIN_FALLBACK=true
DEV_ADMIN_EMAIL=admin@capella.eg
DEV_ADMIN_PASSWORD=admin1234
NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@capella.eg
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=admin1234

# Uploads / Hostinger - planned Phase 12
UPLOAD_MAX_BYTES=4194304
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp
HOSTINGER_HOST=placeholder-hostinger-host
HOSTINGER_PORT=22
HOSTINGER_USERNAME=placeholder-username
HOSTINGER_PASSWORD=placeholder-password
HOSTINGER_REMOTE_DIR=/public_html/uploads
HOSTINGER_PUBLIC_BASE_URL=https://example.com/uploads
