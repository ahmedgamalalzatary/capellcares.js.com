{
  "name": "@capella/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./src/db": "./src/db.ts",
    "./drizzle/schema": "./drizzle/schema.ts",
    "./drizzle/relations": "./drizzle/relations.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ./scripts/run-test-migrations.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seeds/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
